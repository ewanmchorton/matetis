# Настройки сервера. Скопируйте в deploy/.env и подставьте свои значения.
# deploy/.env в Git не попадает. Пароли и ключи вписывает только владелец.

# Адрес приложения без https://. Для проверки на компьютере – localhost.
DOMAIN=matetis.ru

# База. Пароль – только буквы и цифры, сгенерировать: openssl rand -hex 24
POSTGRES_DB=matetis
POSTGRES_USER=matetis
POSTGRES_PASSWORD=

# Секрет для подписи сессий входа. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Сервис рассылок: адрес, порт, логин и пароль SMTP из его личного кабинета.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=МАТЭТИС <no-reply@matetis.ru>

# Уведомления администратору (web-push). Те же ключи, что в .env.local на компьютере,
# иначе подписки на уведомления придётся включать заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Бот МАТЭТИС в Telegram (см. .env.example в корне проекта).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# S3-хранилище для ночных копий базы: адрес, регион, имя бакета и ключ доступа из кабинета провайдера.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Владельцы приложения: почта и ник в Telegram через запятую.
OWNER_ADMINS=
