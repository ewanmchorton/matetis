# Пример настроек. Скопируйте в .env.local и подставьте свои значения.
# .env.local в Git не попадает.

# Подключение к базе. Для локальной базы из docker-compose.yml подходит как есть.
DATABASE_URL=postgres://matetis:matetis@localhost:5432/matetis

# Секрет для подписи сессий входа. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=замените-на-случайную-строку

# Адрес, по которому открывается приложение
BETTER_AUTH_URL=http://localhost:4317

# Отправка писем (коды входа). При разработке подходит как есть: письма ловит Mailpit,
# посмотреть их — http://localhost:8025. На сервере — адрес и пароль сервиса рассылок.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=МАТЭТИС <no-reply@matetis.local>
